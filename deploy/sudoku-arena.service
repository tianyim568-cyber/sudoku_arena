[Unit]
Description=Sudoku Arena Node.js Server
Documentation=https://github.com/yourusername/sudoku-arena
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sudoku-arena/server
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sudoku-arena

# Environment
Environment=NODE_ENV=production

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sudoku-arena/server

[Install]
WantedBy=multi-user.target
