# PostgreSQL connection (set DATABASE_URL for hosted DB, or use individual vars below)
DATABASE_URL=postgresql://user:password@localhost:5432/sudoku_arena

# Individual PG vars as fallback (used if DATABASE_URL is not set)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=sudoku_arena
PG_USER=postgres
PG_PASSWORD=changeme

# SSL (set 'true' for remote/hosted databases)
PG_SSL=false

# JWT — use a strong random string in production (min 32 chars)
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server
PORT=3001
NODE_ENV=development
