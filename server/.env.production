# Production environment for Sudoku Arena
# Copy this file to .env and fill in your actual values

# PostgreSQL connection
DATABASE_URL=postgresql://sudoku_user:STRONG_PASSWORD@localhost:5432/sudoku_arena

# JWT — generate a strong random string (min 32 chars)
# Example: openssl rand -base64 32
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_HERE

# JWT expiration
JWT_EXPIRES_IN=24h

# Server
PORT=3001
NODE_ENV=production

# CORS — set to your actual domain
CORS_ORIGINS=http://39.96.84.142

# PostgreSQL SSL (set to true if using remote database with SSL)
PG_SSL=false
